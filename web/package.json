{
  "name": "graphrt-web",
  "private": true,
  "description": "Browser packages of graphrt: the HTTP client, the UI blocks renderer and the chat widget.",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node scripts/test.mjs",
    "build": "node scripts/build.mjs",
    "check-assets": "node scripts/build.mjs --check",
    "check": "npm run typecheck && npm run lint && npm run test && npm run check-assets"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@types/node": "^22.18.0",
    "esbuild": "0.28.2",
    "happy-dom": "21.0.4",
    "typescript": "~5.9.3"
  }
}
