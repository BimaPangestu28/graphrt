{
  "$schema": "https://biomejs.dev/schemas/2.6.9/schema.json",
  "files": { "includes": ["packages/**/*.ts", "scripts/**/*.mjs", "*.json", "packages/*/package.json"] },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 110 },
  "linter": {
    "rules": {
      "recommended": true,
      "suspicious": { "noExplicitAny": "error" },
      "style": { "noNonNullAssertion": "error" }
    }
  }
}
