# Server-side configuration of the chatbot backend. Copy to `.env` (never commit
# it) or set the same variables as secrets on Fly.io / Cloud Run / your VPS.
# None of these go into the mobile app: the app only holds the Supabase project
# URL, its publishable key and the signed-in user's session.

# The LLM key. Only the server ever sees it.
OPENAI_API_KEY=sk-...

# Locks every endpoint except starting a chat run (which the user JWT opens):
# run lists, events, resume, validate. Use a long random value; no client needs it.
GRAPHRT_API_KEY=change-me-to-a-long-random-string

# The Supabase project, for the plugin's RPC calls.
SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable (or legacy anon) key only. Never a secret / service_role key:
# the plugin refuses them in user_rpc mode, and they bypass RLS.
SUPABASE_KEY=sb_publishable_...

# User JWT verification in graphrt serve (--verify-jwt). Supabase signs access
# tokens with asymmetric keys published here:
GRAPHRT_JWT_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
GRAPHRT_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1
GRAPHRT_JWT_AUDIENCE=authenticated
# Projects still on the legacy HS256 JWT secret: set it here and add
# `--jwt-secret-env SUPABASE_JWT_SECRET` to the serve command.
# SUPABASE_JWT_SECRET=...

# Plugin limits (the image sets these defaults).
SUPABASE_TOOL_MODE=user_rpc
SUPABASE_TOOL_RPC_ALLOWLIST=get_my_profile,list_diary_entries,list_important_dates,list_chat_messages,start_chat_session,add_chat_message
SUPABASE_TOOL_TIMEOUT_MS=8000
SUPABASE_TOOL_MAX_ROWS=50
