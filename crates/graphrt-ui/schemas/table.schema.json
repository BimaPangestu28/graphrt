{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://graphrt.dev/schemas/ui/table.v1.json",
  "title": "graphrt UI block: table",
  "description": "A table: columns with unique keys, and rows whose values are shown under the column with the same key.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$ui", "version", "columns", "rows"],
  "properties": {
    "$ui": { "const": "table" },
    "version": { "const": 1 },
    "title": { "type": "string", "maxLength": 300 },
    "subtitle": { "type": "string", "maxLength": 300 },
    "fallback_text": { "type": "string", "maxLength": 10000 },
    "columns": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "label"],
        "properties": {
          "key": { "type": "string", "minLength": 1, "maxLength": 300 },
          "label": { "type": "string", "minLength": 1, "maxLength": 300 },
          "align": { "enum": ["left", "center", "right"] },
          "format": { "enum": ["text", "date", "status", "number", "compact", "percent", "currency"] },
          "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
        }
      }
    },
    "rows": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": { "type": ["string", "number", "boolean", "null"], "maxLength": 10000 }
      }
    }
  }
}
