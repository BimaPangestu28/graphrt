{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://graphrt.dev/schemas/ui/adaptive_card.v1.json",
  "title": "graphrt UI block: adaptive_card",
  "description": "An Adaptive Card (schema 1.0-1.6). Supported elements: TextBlock, RichTextBlock, Image, ImageSet, Container, ColumnSet, Column, FactSet, ActionSet, Table, Input.Text, Input.Number, Input.Date, Input.Time, Input.Toggle, Input.ChoiceSet; actions: Action.Submit, Action.Execute, Action.OpenUrl, Action.ShowCard, Action.ToggleVisibility. Other element types need a fallback. Images: https or data:image/(png|jpeg|gif|webp). Links: https or mailto. No ${...} templates. graphrt-ui's validator also checks each element's properties, unique input ids and size limits.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$ui",
    "version",
    "card"
  ],
  "properties": {
    "$ui": {
      "const": "adaptive_card"
    },
    "version": {
      "const": 1
    },
    "title": {
      "type": "string",
      "maxLength": 300
    },
    "fallback_text": {
      "type": "string",
      "maxLength": 10000
    },
    "card": {
      "allOf": [
        {
          "$ref": "#/$defs/card"
        },
        {
          "required": [
            "version"
          ]
        }
      ]
    }
  },
  "$defs": {
    "card": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "AdaptiveCard"
        },
        "version": {
          "enum": [
            "1.0",
            "1.1",
            "1.2",
            "1.3",
            "1.4",
            "1.5",
            "1.6"
          ]
        },
        "body": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/element"
          }
        },
        "actions": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/action"
          }
        },
        "fallbackText": {
          "type": "string"
        }
      },
      "description": "Cards inside Action.ShowCard may leave out version"
    },
    "imageUrl": {
      "type": "string",
      "pattern": "^(https://[^\\s@/?#]+.*|data:image/(png|jpeg|gif|webp);base64,.*)$"
    },
    "element": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/element"
          }
        },
        "columns": {
          "type": "array"
        },
        "url": {
          "$ref": "#/$defs/imageUrl"
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          }
        },
        "selectAction": {
          "$ref": "#/$defs/action"
        },
        "fallback": {
          "anyOf": [
            {
              "const": "drop"
            },
            {
              "$ref": "#/$defs/element"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "TextBlock"
              }
            }
          },
          "then": {
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "string",
                "not": {
                  "pattern": "\\$\\{"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "Image"
              }
            }
          },
          "then": {
            "required": [
              "url"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "FactSet"
              }
            }
          },
          "then": {
            "required": [
              "facts"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "pattern": "^Input\\."
              }
            }
          },
          "then": {
            "required": [
              "id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "Input.ChoiceSet"
              }
            }
          },
          "then": {
            "required": [
              "choices"
            ]
          }
        }
      ]
    },
    "action": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "verb": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "maxLength": 300
        },
        "style": {
          "enum": [
            "default",
            "positive",
            "destructive"
          ]
        },
        "data": {
          "type": [
            "object",
            "string"
          ]
        },
        "card": {
          "$ref": "#/$defs/card"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "Action.OpenUrl"
              }
            }
          },
          "then": {
            "required": [
              "url"
            ],
            "properties": {
              "url": {
                "type": "string",
                "pattern": "^(https://[^\\s@/?#]+.*|mailto:.+)$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "Action.ShowCard"
              }
            }
          },
          "then": {
            "required": [
              "card"
            ]
          }
        }
      ]
    }
  }
}
